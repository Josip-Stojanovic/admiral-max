# Copy to .env on the box. Never committed. Every secret the runtime needs is here and nowhere else.

# Caddy
DOMAIN=admiralmax.hr
ACME_EMAIL=hostmaster@stojanovic.cv

# Reservation bot (the restaurant's own bot and staff group — not the cluster's alert bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
POSTGRES_USER=admiral
POSTGRES_PASSWORD=
POSTGRES_DB=admiral
DATABASE_URL=postgres://admiral:${POSTGRES_PASSWORD}@db:5432/admiral

# Outbound mail (the shared relay, submission port — never a mail server on this box)
SMTP_HOST=mail.stojanovic.cv
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=rezervacije@admiralmax.hr
